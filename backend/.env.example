# Database
DATABASE_URL="postgresql://username:password@localhost:5432/dermq_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server
PORT=3000
CORS_ORIGINS="http://localhost:3001"

# NubeFact Integration (Facturación Electrónica Perú)
NUBEFACT_API_URL="https://api.nubefact.com/api/v1"
NUBEFACT_API_TOKEN="your-nubefact-token"

# Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID="your-google-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Payment Gateway (Culqi - deprecated, now using Izipay)
CULQI_PUBLIC_KEY="your-culqi-public-key"
CULQI_SECRET_KEY="your-culqi-secret-key"

# Izipay / Lyra API Integration
IZIPAY_SHOP_ID="your-izipay-shop-id-from-backoffice"
IZIPAY_SHOP_KEY="your-izipay-shop-key-from-backoffice"
IZIPAY_PUBLIC_KEY="your-izipay-public-key-from-backoffice"
IZIPAY_HMAC_KEY="your-izipay-hmac-key-from-backoffice"
IZIPAY_API_URL="https://api.micuentaweb.pe/api-payment/v4/Charge/CreatePayment"

# Supabase Storage Integration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="dermq"