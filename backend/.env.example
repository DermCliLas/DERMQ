# Database
DATABASE_URL="postgresql://username:password@localhost:5432/dermq_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server
PORT=3000
CORS_ORIGINS="http://localhost:3001"

# NubeFact Integration (Facturación Electrónica Perú)
NUBEFACT_API_URL="https://api.nubefact.com/api/v1"
NUBEFACT_API_TOKEN="your-nubefact-token"

# Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID="your-google-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Payment Gateway (Culqi)
CULQI_PUBLIC_KEY="your-culqi-public-key"
CULQI_SECRET_KEY="your-culqi-secret-key"